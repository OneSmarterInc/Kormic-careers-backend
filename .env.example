# Copy to .env and adjust. Nothing here is read automatically — export these,
# or use your own loader. Committing a filled-in .env is what this file exists
# to avoid.

# Local development. With this on, a dev secret key applies, localhost is
# allowed, and the dev login endpoint works.
DJANGO_DEBUG=1

# Required as soon as DEBUG is off. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma separated. No wildcard.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated origins allowed to call this API from a browser.
DJANGO_CORS_ORIGINS=http://localhost:8081

# Defaults to sqlite in the project directory.
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=kormic
# DJANGO_DB_USER=
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432
